# SPA Fallback para Apache (Hostinger)
# Garante que rotas como /admin e /admin/login funcionem ao acessar
# diretamente ou ao recarregar a página (F5).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Não reescrever para arquivos ou diretórios reais (assets, imagens, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todas as outras rotas vão para o index.html (SPA - React Router)
  RewriteRule ^ index.html [L]
</IfModule>

# Compressão (melhora performance)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # index.html nunca em cache para garantir atualizações
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
